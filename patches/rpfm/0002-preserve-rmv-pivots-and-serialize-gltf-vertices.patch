+
+/// Encode the decoded vertex fields explicitly at the offsets used by the glTF
+/// accessors. `Vertex` contains nalgebra vectors and has no stable packed Rust
+/// representation, so transmuting the struct exposes alignment padding as UV,
+/// normal, tangent, joint, and weight data.
+const GLTF_VERTEX_STRIDE: usize = 120;
+
+fn encode_vertices(vertices: &[Vertex]) -> Vec<u8> {
+    let mut bytes = Vec::with_capacity(vertices.len() * GLTF_VERTEX_STRIDE);
+    for vertex in vertices {
+        for value in vertex.position().iter() { bytes.extend_from_slice(&value.to_le_bytes()); }
+        for value in vertex.texture_coordinate().iter() { bytes.extend_from_slice(&value.to_le_bytes()); }
+        for value in vertex.texture_coordinate2().iter() { bytes.extend_from_slice(&value.to_le_bytes()); }
+        for value in vertex.normal().iter() { bytes.extend_from_slice(&value.to_le_bytes()); }
+        for value in vertex.tangent().iter() { bytes.extend_from_slice(&value.to_le_bytes()); }
+        for value in vertex.bitangent().iter() { bytes.extend_from_slice(&value.to_le_bytes()); }
+        for value in vertex.color().iter() { bytes.extend_from_slice(&value.to_le_bytes()); }
+        bytes.extend_from_slice(vertex.bone_indices().as_slice());
+        for value in vertex.weights().iter() { bytes.extend_from_slice(&value.to_le_bytes()); }
+        bytes.extend_from_slice(vertex.uk_1().as_slice());
+    }
+    debug_assert_eq!(bytes.len(), vertices.len() * GLTF_VERTEX_STRIDE);
+    bytes
+}
